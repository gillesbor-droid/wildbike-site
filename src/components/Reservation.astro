---
const actions = [
  {
    title: 'Cours à l’année',
    href: 'https://wildbike.fr/club/',
    label: 'Voir la page Club',
  },
  {
    title: 'Stages vacances',
    href: 'https://wildbike.fr/stages/',
    label: 'Voir les stages',
  },
  {
    title: 'Apprendre à rouler',
    href: 'https://wildbike.fr/veloecole/',
    label: 'Voir la vélo-école',
  },
];
---

<section id="reservation" class="bg-edit-teal text-white py-32">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="font-display text-xs tracking-widest text-white/70">
      PROCHAINE ÉTAPE
    </span>
    <h2 class="font-display text-5xl md:text-7xl tracking-tighter leading-none mt-6 mb-8">
      CHOISISSEZ LE BON PARCOURS WILD BIKE
    </h2>
    <p class="text-white/90 text-base md:text-lg leading-relaxed font-medium mb-8">
      Vous pouvez partir vers la page la plus adaptée, ou réserver directement
      un cours d'essai BMX/VTT si votre enfant veut découvrir le club.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10 text-left">
      {
        actions.map((action) => (
          <a href={action.href} class="group bg-black text-white p-6 hover:bg-white hover:text-black transition-colors">
            <span class="font-display text-xl tracking-tight block mb-3">{action.title}</span>
            <span class="font-display text-xs tracking-widest text-white/60 group-hover:text-black/60">{action.label}</span>
          </a>
        ))
      }
    </div>
    <a
      href="https://docs.google.com/forms/d/e/1FAIpQLSd3iMWrb7wpacYt7c5cc9xX0y1GVrfiwts5CNG1ru8F5ZE09g/viewform?usp=dialog"
      class="inline-flex items-center justify-center gap-3 bg-white text-black hover:bg-black hover:text-white transition-colors duration-300 font-display text-xs tracking-widest px-10 py-5"
    >
      RÉSERVER UN COURS D'ESSAI BMX/VTT
      <iconify-icon icon="solar:arrow-right-linear" width="16" stroke-width="2"></iconify-icon>
    </a>
    <p class="text-white/80 text-sm font-medium mt-6">
      Une question sur le niveau, le matériel ou la bonne activité ? Contactez
      Wild Bike au
      <a href="tel:0750903677" class="underline hover:text-black">
        07 50 90 36 77
      </a>.
    </p>
  </div>
</section>
