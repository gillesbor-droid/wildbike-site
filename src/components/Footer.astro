---
const footerLinks = {
  pratique: {
    title: 'PRATIQUE',
    links: [
      { label: 'Club BMX & VTT', href: 'https://wildbike.fr/club/' },
      { label: 'Stages vacances', href: 'https://wildbike.fr/stages/' },
      { label: 'Vélo école', href: 'https://wildbike.fr/veloecole/' },
      { label: 'FAQ', href: 'https://wildbike.fr/faq/' },
    ],
  },
  contact: {
    title: 'CONTACT',
    links: [
      { label: 'Cours d’essai', href: 'https://docs.google.com/forms/d/e/1FAIpQLSd3iMWrb7wpacYt7c5cc9xX0y1GVrfiwts5CNG1ru8F5ZE09g/viewform?usp=dialog' },
      { label: 'Téléphone', href: 'tel:0750903677' },
      { label: 'Instagram', href: 'https://www.instagram.com/wildbike83/?hl=fr' },
      { label: 'Facebook', href: 'https://www.facebook.com/wildbike83/' },
    ],
  },
};
---

<footer class="md:px-12 text-white bg-black border-edit-gray border-t pt-20 pr-6 pb-12 pl-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 mb-20 fade-up">
    <div class="col-span-1 md:col-span-2">
      <a href="#" class="flex items-center gap-1 mb-8">
        <span class="font-display text-4xl tracking-tighter">Wild Bike</span>
        <div class="flex gap-[0.1rem] mt-2">
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
        </div>
      </a>
      <p class="text-white/50 text-xs md:text-sm max-w-sm mb-8 font-medium leading-relaxed">
        Club BMX et VTT Freestyle pour enfants dès 5 ans autour de Toulon,
        La Seyne-sur-Mer, Six-Fours et Ollioules.
      </p>
      <div class="flex gap-3">
        <a
          href="https://www.instagram.com/wildbike83/?hl=fr"
          class="w-10 h-10 border border-white/10 hover:border-edit-teal hover:bg-edit-teal transition-all duration-300 flex items-center justify-center"
        >
          <iconify-icon icon="solar:camera-linear" width="18"></iconify-icon>
        </a>
        <a
          href="mailto:contact@wildbike.fr"
          class="w-10 h-10 border border-white/10 hover:border-edit-teal hover:bg-edit-teal transition-all duration-300 flex items-center justify-center"
        >
          <iconify-icon icon="solar:letter-linear" width="18"></iconify-icon>
        </a>
      </div>
    </div>

    {
      Object.values(footerLinks).map((col) => (
        <div>
          <h4 class="font-display text-sm tracking-widest mb-6 text-edit-teal">
            {col.title}
          </h4>
          <ul class="space-y-4 text-xs font-medium text-white/60">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="max-w-7xl mx-auto pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/40 font-medium fade-up"
  >
    <p>© 2026 Wild Bike. Tous droits réservés.</p>
    <div class="flex gap-6">
      <a href="https://wildbike.fr/contact/" class="hover:text-white transition-colors">Contact</a>
      <a href="https://wildbike.fr/faq/" class="hover:text-white transition-colors">FAQ</a>
    </div>
  </div>
</footer>
