---
const footerLinks = {
  pratique: {
    title: 'NAVIGATION',
    links: [
      { label: 'Accueil', href: '/' },
      { label: 'Club BMX & VTT', href: '/club/' },
      { label: 'Stages vacances', href: '/stages/' },
      { label: 'Vélo école', href: '/veloecole/' },
      { label: 'FAQ', href: '/faq/' },
    ],
  },
  contact: {
    title: 'CONTACT',
    links: [
      { label: 'Vérifier les places', href: 'https://wa.me/33750903677?text=Bonjour%20Wild%20Bike%2C%20je%20souhaite%20savoir%20quel%20parcours%20est%20adapt%C3%A9%20%C3%A0%20mon%20enfant.' },
      { label: 'Téléphone', href: 'tel:0750903677' },
      { label: 'Instagram', href: 'https://www.instagram.com/wildbike83/?hl=fr' },
      { label: 'Facebook', href: 'https://www.facebook.com/wildbike83/' },
    ],
  },
};
---

<footer class="md:px-12 text-white bg-black border-edit-gray border-t pt-20 pr-6 pb-12 pl-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 mb-20 fade-up">
    <div class="col-span-1 md:col-span-2">
      <a href="/" class="flex items-center gap-1 mb-8" aria-label="Wild Bike, accueil">
        <span class="font-display text-4xl tracking-tighter">Wild Bike</span>
        <div class="flex gap-[0.1rem] mt-2">
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
          <div class="w-2 h-2 bg-edit-teal"></div>
        </div>
      </a>
      <p class="text-white/50 text-xs md:text-sm max-w-sm mb-8 font-medium leading-relaxed">
        BMX, VTT freestyle, stages vacances, vélo-école et événements autour
        de Toulon, La Seyne-sur-Mer, Six-Fours et Ollioules.
      </p>
      <div class="flex gap-3">
        <a
          href="https://www.instagram.com/wildbike83/?hl=fr"
          aria-label="Instagram Wild Bike"
          class="w-10 h-10 border border-white/10 hover:border-edit-teal hover:bg-edit-teal transition-all duration-300 flex items-center justify-center"
        >
          <iconify-icon icon="solar:camera-linear" width="18"></iconify-icon>
        </a>
        <a
          href="mailto:contact@wildbike.fr"
          aria-label="Envoyer un e-mail à Wild Bike"
          class="w-10 h-10 border border-white/10 hover:border-edit-teal hover:bg-edit-teal transition-all duration-300 flex items-center justify-center"
        >
          <iconify-icon icon="solar:letter-linear" width="18"></iconify-icon>
        </a>
      </div>
    </div>

    {
      Object.values(footerLinks).map((col) => (
        <div>
          <h4 class="font-display text-sm tracking-widest mb-6 text-edit-teal">
            {col.title}
          </h4>
          <ul class="space-y-4 text-xs font-medium text-white/60">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="max-w-7xl mx-auto pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/70 font-medium fade-up"
  >
    <p>© 2026 Wild Bike. Tous droits réservés.</p>
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-3">
      <a href="/contact/" class="hover:text-white transition-colors">Contact</a>
      <a href="/faq/" class="hover:text-white transition-colors">FAQ</a>
      <a href="/mentions-legal-du-site-wildbike-fr/" class="hover:text-white transition-colors">Mentions légales</a>
      <a href="/confidentialite/" class="hover:text-white transition-colors">Confidentialité</a>
      <a href="/cgv/" class="hover:text-white transition-colors">CGV</a>
    </div>
  </div>
</footer>
