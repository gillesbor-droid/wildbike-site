---
const testimonials = [
  {
    quote: "« 2 ans que notre fils fait du BMX avec Gilles et quelques stages également ! Encadrement au top, activités proposées diversifiées, bel accompagnement des enfants. »",
    author: 'Maelle BH',
  },
  {
    quote: "« Une super structure ! Encadrement au top, à l’écoute et très pro. Une première saison pour mon fils en BMX avec Gilles, il n’y a pas mieux. »",
    author: 'Hervé Riché',
  },
  {
    quote: "« Mon fils suit les cours et a participé à un stage. Il progresse rapidement en prenant du plaisir. Accompagnement sérieux et ludique. »",
    author: 'Chloé Colin',
  },
];
---

<section class="bg-white text-black py-32">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <span class="text-edit-teal font-display text-xs tracking-widest">
      TÉMOIGNAGES
    </span>
    <h2 class="font-display text-5xl md:text-7xl tracking-tighter leading-none mt-6 mb-14">
      CE QUE DISENT LES PARENTS
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {
        testimonials.map((t) => (
          <blockquote class="border-t-4 border-edit-teal bg-zinc-100 p-8">
            <iconify-icon
              icon="solar:quote-right-linear"
              class="text-edit-teal text-3xl mb-6"
            />
            <p class="font-display text-xl leading-snug">{t.quote}</p>
            <footer class="text-sm font-medium text-black/50 mt-8">{t.author}</footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
