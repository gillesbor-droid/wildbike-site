---
const offers = [
  {
    title: 'Club BMX & VTT',
    text: "Cours à l'année, BMX et VTT freestyle, dès 5 ans sur Toulon, La Seyne-sur-Mer, Six-Fours et Ollioules.",
    href: 'https://wildbike.fr/club/',
    label: 'Découvrir le club',
  },
  {
    title: 'Stages vacances',
    text: 'Stages BMX et VTT pendant les vacances scolaires : skateparks, forêt, pumptrack, airbag, road trip et progression.',
    href: 'https://wildbike.fr/stages/',
    label: 'Voir les stages',
  },
  {
    title: 'Vélo école',
    text: 'Cours particuliers enfants et adultes pour apprendre à rouler, reprendre confiance ou accompagner la mobilité douce.',
    href: 'https://wildbike.fr/veloecole/',
    label: 'Découvrir la vélo-école',
  },
  {
    title: 'Boutique',
    text: 'Textiles, accessoires, vélos, équipements et produits Wild Bike pour afficher les couleurs du club.',
    href: 'https://www.helloasso.com/associations/wild-bike/boutiques/catalogue-wb-2025',
    label: 'Voir la boutique',
  },
];
---

<section class="py-32 bg-edit-dark text-white relative overflow-hidden" id="ethos">
  <!-- Background Grid Pattern -->
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(#ffffff 1px, transparent 1px), linear-gradient(to right, #ffffff 1px, transparent 1px); background-size: 4rem 4rem;"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="max-w-4xl fade-up">
      <div class="flex items-center gap-4 mb-6">
        <span class="text-edit-teal font-display text-xs tracking-widest">
          WILD BIKE
        </span>
        <div class="w-12 h-px bg-edit-teal"></div>
      </div>
      <h2 class="font-display text-5xl md:text-7xl tracking-tighter leading-none mb-10">
        WILD BIKE : LE CLUB QUI FAIT PROGRESSER LES ENFANTS GRÂCE AU VÉLO
      </h2>
      <p class="text-white/70 text-base md:text-lg leading-relaxed font-medium">
        Wild Bike est un club spécialisé BMX Freestyle et VTT Freestyle. Les
        enfants roulent chaque semaine dans un groupe adapté à leur âge et à
        leur niveau. Ils apprennent progressivement les bases, la technique,
        l'équilibre, les sauts, la gestion du risque et l'esprit d'équipe.
        Chez Wild Bike, l'enfant est le héros. Le vélo devient un terrain
        d'apprentissage pour développer la confiance en soi, l'autonomie, la
        persévérance, la coordination, la gestion du risque, le respect,
        l'entraide et le plaisir de progresser avec les autres.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-16">
      {
        offers.map((offer) => (
          <article class="border border-white/15 bg-white/5 p-6 fade-up">
            <h3 class="font-display text-2xl tracking-tight mb-4">{offer.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed font-medium mb-6">{offer.text}</p>
            <a
              href={offer.href}
              class="font-display text-xs tracking-widest text-edit-teal hover:text-white transition-colors"
            >
              {offer.label}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
