---
const steps = [
  {
    num: '01',
    title: 'COURS À L’ANNÉE',
    text: "Pour les enfants dès 5 ans qui veulent rouler chaque semaine, progresser dans un groupe et rejoindre une vraie dynamique club.",
    href: 'https://wildbike.fr/club/',
    label: 'Découvrir le club',
  },
  {
    num: '02',
    title: 'STAGES VACANCES',
    text: "Pour vivre des journées fortes en BMX ou VTT : skateparks, forêt, pumptracks, airbag, road trips et défis adaptés au niveau.",
    href: '/stages/',
    label: 'Voir les stages',
  },
  {
    num: '03',
    title: 'VÉLO-ÉCOLE',
    text: "Pour apprendre à rouler, reprendre confiance ou accompagner la mobilité douce, avec des séances enfants, adultes, entreprises ou collectivités.",
    href: 'https://wildbike.fr/veloecole/',
    label: 'Découvrir la vélo-école',
  },
  {
    num: '04',
    title: 'ÉVÉNEMENTS & BOUTIQUE',
    text: "Pour suivre les initiations, shows, animations, sorties et retrouver les textiles, accessoires et équipements Wild Bike.",
    href: 'https://www.helloasso.com/associations/wild-bike/boutiques/catalogue-wb-2025',
    label: 'Voir la boutique',
  },
];
---

<section class="relative py-32 md:py-48 text-white text-center overflow-hidden" id="movement">
  <div class="absolute inset-0 w-full h-full">
    <img
      src="/images/stage-famille-roue.jpg"
      alt="Rider Wild Bike en BMX freestyle"
      class="w-full h-full object-cover filter grayscale contrast-150"
    />
    <div class="absolute inset-0 bg-edit-teal/90 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 fade-up">
    <span class="font-display text-white/80 text-xs tracking-widest mb-6 block">
      LES EXPÉRIENCES WILD BIKE
    </span>
    <h2 class="font-display text-5xl md:text-7xl tracking-tighter mb-14 leading-none">
      À CHACUN SA FAÇON DE ROULER
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
      {
        steps.map((step) => (
          <a
            href={step.href}
            aria-label={step.label}
            class="group block border border-white/20 bg-black/50 p-8 transition-all duration-500 hover:-translate-y-2 hover:border-white hover:bg-white hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            <span class="font-display text-edit-teal text-3xl">{step.num}</span>
            <h3 class="font-display text-2xl tracking-tight mt-6">{step.title}</h3>
            <p class="text-white/75 group-hover:text-black/70 text-sm leading-relaxed font-medium mt-4 transition-colors">{step.text}</p>
            <span class="mt-7 inline-flex items-center gap-2 font-display text-xs tracking-widest text-edit-teal">
              {step.label}
              <iconify-icon icon="solar:arrow-right-linear" class="transition-transform duration-300 group-hover:translate-x-1" width="15"></iconify-icon>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
