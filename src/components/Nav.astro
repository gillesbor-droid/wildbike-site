---
interface Props {
  page?: 'home' | 'club' | 'stages' | 'veloecole' | 'faq' | 'none';
}

const { page = 'home' } = Astro.props;
const isStagesPage = page === 'stages';
const isVeloEcolePage = page === 'veloecole';
const navLinks = [
  { href: '/', label: 'ACCUEIL', active: page === 'home' },
  { href: '/club/', label: 'CLUB', active: page === 'club' },
  { href: '/stages/', label: 'STAGES', active: isStagesPage },
  { href: '/veloecole/', label: 'VÉLO-ÉCOLE', active: isVeloEcolePage },
  { href: '/faq/', label: 'FAQ', active: page === 'faq' },
];

const logoHref = page === 'home' ? '#' : '/';
---

<nav
  class="fixed top-0 left-0 w-full z-50 py-6 px-6 md:px-12 flex justify-between items-center mix-blend-nav transition-all duration-300"
>
  <a href={logoHref} class="flex items-center gap-1 group" aria-label="Wild Bike, accueil">
    <span class="font-display text-2xl md:text-3xl tracking-tighter">
      Wild Bike
    </span>
    <div class="flex gap-[0.1rem] mt-1">
      <div class="w-1.5 h-1.5 bg-edit-teal"></div>
      <div class="w-1.5 h-1.5 bg-edit-teal"></div>
      <div class="w-1.5 h-1.5 bg-edit-teal"></div>
      <div class="w-1.5 h-1.5 bg-edit-teal"></div>
      <div class="w-1.5 h-1.5 bg-edit-teal"></div>
    </div>
  </a>

  <div class="hidden md:flex gap-6 lg:gap-8">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? 'page' : undefined}
          class:list={[
            'font-display text-xs tracking-widest transition-colors duration-300 hover:text-edit-teal',
            { 'text-edit-teal': link.active },
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <details class="group relative md:hidden">
    <summary class="cursor-pointer list-none border border-white/40 px-4 py-3 font-display text-xs tracking-widest marker:content-none">
      MENU
    </summary>
    <div class="absolute right-0 top-[calc(100%+0.75rem)] flex min-w-52 flex-col border border-white/20 bg-black p-2 text-white shadow-2xl">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={link.active ? 'page' : undefined}
            class:list={[
              'px-4 py-3 font-display text-xs tracking-widest transition-colors hover:bg-edit-teal hover:text-white',
              { 'text-edit-teal': link.active },
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </details>
</nav>
