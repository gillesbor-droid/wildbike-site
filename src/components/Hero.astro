---
---

<header
  class="relative h-screen w-full flex items-center justify-center overflow-hidden"
  id="prologue"
>
  <div class="absolute inset-0 w-full h-full">
    <img
      src="https://images.unsplash.com/photo-1502744688674-c619d1586c9e?q=80&w=2000&auto=format&fit=crop&grayscale=true"
      alt="Jeune rider BMX en freestyle"
      class="w-full h-full object-cover object-center filter grayscale contrast-125 scale-105 transform origin-center animate-[pulse_20s_ease-in-out_infinite]"
    />
    <div class="absolute inset-0 solid-overlay z-10"></div>
    <div class="vignette z-10 absolute top-0 right-0 bottom-0 left-0"></div>
  </div>

  <div class="relative z-20 w-full px-6 md:px-12 text-center flex flex-col items-center mt-16">
    <span class="font-display text-edit-teal text-xs md:text-sm tracking-widest mb-6 fade-up">
      1.4 Billion Heartbeats. One Rhythm.
    </span>
    <h1
      class="font-display text-white text-5xl md:text-7xl lg:text-8xl max-w-5xl tracking-tighter leading-none mb-8 fade-up"
      style="animation-delay: 100ms;"
    >
      LE VÉLO QUI LUI DONNE CONFIANCE
    </h1>
    <p
      class="text-white/80 text-sm md:text-base max-w-xl mx-auto mb-12 fade-up"
      style="animation-delay: 200ms;"
    >
      BMX ou VTT Freestyle, des cours adaptés à son âge et à son niveau pour
      progresser, s'amuser et prendre confiance.
    </p>
    <a
      href="#reservation"
      class="bg-edit-teal text-white hover:bg-white hover:text-black transition-colors duration-300 font-display text-xs tracking-widest px-10 py-5 flex items-center justify-center gap-3 w-fit mx-auto fade-up"
      style="animation-delay: 300ms;"
    >
      RÉSERVER UN COURS D'ESSAI GRATUIT
      <iconify-icon icon="solar:arrow-right-linear" width="16" stroke-width="2"></iconify-icon>
    </a>
    <div class="fade-up" style="animation-delay: 300ms;">
      <iconify-icon
        icon="solar:mouse-circle-linear"
        class="text-white/50 text-3xl animate-bounce"
      ></iconify-icon>
    </div>
  </div>
</header>
